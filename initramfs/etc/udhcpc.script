#!/bin/sh
# udhcpc hook: set the lease as the primary address, keep the $interface:1 alias
case "$1" in
deconfig)
	ifconfig $interface 0.0.0.0
	;;
bound|renew)
	ifconfig $interface $ip netmask ${subnet:-255.255.255.0}
	while route del default 2>/dev/null; do :; done
	for r in $router; do route add default gw $r dev $interface; break; done
	if [ -f /data/dnsmasq.conf ]; then
		echo "nameserver 127.0.0.1" > /etc/resolv.conf
	else
		: > /etc/resolv.conf
		for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
	fi
	;;
esac
exit 0
