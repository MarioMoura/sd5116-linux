#!/bin/sh
# Button handler.
#   reset: short press reboots, hold >= 5 s erases /data (factory reset) and reboots
#   light: toggles all LEDs off/on

KEY_RESTART=408
KEY_LIGHTS_TOGGLE=542

dev=
for d in /sys/class/input/event*; do
	[ "$(cat $d/device/name)" = keys ] && dev=/dev/input/${d##*/}
done
[ -n "$dev" ] || exit 1

factory_reset() {
	for l in /sys/class/leds/*; do echo timer > $l/trigger; done
	echo "buttond: factory reset, erasing /data"
	umount /data
	flash_eraseall -j $(mtdname data)
	sync
	reboot -f
}

toggle_leds() {
	if [ -f /tmp/leds.saved ]; then
		while read l b; do echo $b > $l/brightness; done < /tmp/leds.saved
		rm /tmp/leds.saved
	else
		for l in /sys/class/leds/*; do
			echo "$l $(cat $l/brightness)" >> /tmp/leds.saved
			echo 0 > $l/brightness
		done
	fi
}

exec 3< $dev
down=0
while :; do
	# struct input_event (32-bit): sec, usec, type, code, value
	set -- $(dd bs=16 count=1 <&3 2>/dev/null |
		hexdump -v -e '1/4 "%u" " " 1/4 "%u" " " 1/2 "%u" " " 1/2 "%u" " " 1/4 "%d"')
	[ "$3" = 1 ] || continue
	case "$4:$5" in
	$KEY_RESTART:1)
		down=$1 ;;
	$KEY_RESTART:0)
		if [ $(($1 - down)) -ge 5 ]; then
			factory_reset
		else
			echo "buttond: reset pressed, rebooting"
			reboot -f
		fi ;;
	$KEY_LIGHTS_TOGGLE:1)
		toggle_leds ;;
	esac
done
