#!/bin/sh
# sysupgrade [-s a|b] <dir|http-url>
# Source holds slot-a.bin, slot-b.bin and sha256sums (from tools/mkflash.py image).
# Writes the inactive slot, arms a one-shot boot into it and reboots. The new slot
# becomes permanent only after it boots with the LAN port up (see /init); otherwise the
# next boot falls back to the current slot.
set -e

cur=$(sed -n 's/.* slot=\([ab]\).*/\1/p;s/^slot=\([ab]\).*/\1/p' /proc/cmdline)
tgt=
if [ "$1" = -s ]; then tgt=$2; shift 2; fi
if [ -z "$tgt" ]; then
	[ -n "$cur" ] || { echo "running slot unknown (TFTP boot?), use -s a|b"; exit 1; }
	[ "$cur" = a ] && tgt=b || tgt=a
fi
[ "$tgt" = a ] || [ "$tgt" = b ] || { echo "bad slot '$tgt'"; exit 1; }
[ "$tgt" != "$cur" ] || { echo "refusing to overwrite the running slot"; exit 1; }
[ -n "$1" ] || { echo "usage: sysupgrade [-s a|b] <dir|http-url>"; exit 1; }

img=slot-$tgt.bin
tmp=/tmp/upgrade
rm -rf $tmp && mkdir -p $tmp
case "$1" in
http://*)
	wget -q -O $tmp/$img "$1/$img"
	wget -q -O $tmp/sha256sums "$1/sha256sums" ;;
*)
	cp "$1/$img" "$1/sha256sums" $tmp/ ;;
esac
cd $tmp
grep " $img\$" sha256sums | sha256sum -c -

env=$(mtdname u-boot-env)
flashcp $img $(mtdname firmware-$tgt)
if [ -n "$cur" ]; then
	flashcp /etc/uboot/env-try-$tgt.bin $env
	echo "slot $tgt written, trial boot armed (fallback: slot $cur)"
else
	flashcp /etc/uboot/env-$tgt.bin $env
	echo "slot $tgt written and made default"
fi
rm -rf $tmp
sync
reboot -f
