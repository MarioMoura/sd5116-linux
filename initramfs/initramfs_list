# Initramfs for SD5116 with busybox
# Format: see usr/gen_init_cpio.c in kernel source

# Directories
dir /bin 0755 0 0
dir /sbin 0755 0 0
dir /dev 0755 0 0
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /tmp 1777 0 0
dir /etc 0755 0 0
dir /var 0755 0 0
dir /var/run 0755 0 0

# Device nodes
nod /dev/console 0600 0 0 c 5 1
nod /dev/null 0666 0 0 c 1 3
nod /dev/mem 0600 0 0 c 1 1

# Busybox
file /bin/busybox ${ONU_ROOT}/initramfs/busybox 0755 0 0

# Symlinks for essential commands
slink /bin/sh busybox 0777 0 0
slink /bin/ash busybox 0777 0 0
slink /bin/cat busybox 0777 0 0
slink /bin/ls busybox 0777 0 0
slink /bin/cp busybox 0777 0 0
slink /bin/mv busybox 0777 0 0
slink /bin/rm busybox 0777 0 0
slink /bin/ln busybox 0777 0 0
slink /bin/mkdir busybox 0777 0 0
slink /bin/mknod busybox 0777 0 0
slink /bin/chmod busybox 0777 0 0
slink /bin/mount busybox 0777 0 0
slink /bin/echo busybox 0777 0 0
slink /bin/grep busybox 0777 0 0
slink /bin/dmesg busybox 0777 0 0
slink /bin/ps busybox 0777 0 0
slink /bin/kill busybox 0777 0 0
slink /bin/sleep busybox 0777 0 0
slink /bin/head busybox 0777 0 0
slink /bin/tail busybox 0777 0 0
slink /bin/dd busybox 0777 0 0
slink /bin/vi busybox 0777 0 0
slink /bin/find busybox 0777 0 0
slink /bin/pwd busybox 0777 0 0
slink /bin/hostname busybox 0777 0 0
slink /bin/ping busybox 0777 0 0
slink /bin/wget busybox 0777 0 0
slink /bin/telnet busybox 0777 0 0
slink /bin/free busybox 0777 0 0
slink /bin/devmem busybox 0777 0 0
slink /bin/setsid busybox 0777 0 0
slink /bin/cttyhack busybox 0777 0 0

# Network commands
slink /sbin/ifconfig ../bin/busybox 0777 0 0
slink /sbin/ip ../bin/busybox 0777 0 0
slink /sbin/route ../bin/busybox 0777 0 0
slink /sbin/arp ../bin/busybox 0777 0 0
slink /bin/netstat busybox 0777 0 0
slink /sbin/mdev ../bin/busybox 0777 0 0
slink /sbin/reboot ../bin/busybox 0777 0 0
slink /sbin/halt ../bin/busybox 0777 0 0

# Init: /init starts BusyBox init, which runs rcS and the runsv services
file /init ${ONU_ROOT}/initramfs/init_script 0755 0 0
file /etc/inittab ${ONU_ROOT}/initramfs/etc/inittab 0644 0 0
dir /etc/init.d 0755 0 0
file /etc/init.d/rcS ${ONU_ROOT}/initramfs/etc/init.d/rcS 0755 0 0
file /etc/init.d/rcK ${ONU_ROOT}/initramfs/etc/init.d/rcK 0755 0 0
dir /etc/sv 0755 0 0
dir /etc/sv/syslogd 0755 0 0
file /etc/sv/syslogd/run ${ONU_ROOT}/initramfs/etc/sv/syslogd/run 0755 0 0
dir /etc/sv/dhcp 0755 0 0
file /etc/sv/dhcp/run ${ONU_ROOT}/initramfs/etc/sv/dhcp/run 0755 0 0
dir /etc/sv/ntpd 0755 0 0
file /etc/sv/ntpd/run ${ONU_ROOT}/initramfs/etc/sv/ntpd/run 0755 0 0
dir /etc/sv/dropbear 0755 0 0
file /etc/sv/dropbear/run ${ONU_ROOT}/initramfs/etc/sv/dropbear/run 0755 0 0
dir /etc/sv/buttond 0755 0 0
file /etc/sv/buttond/run ${ONU_ROOT}/initramfs/etc/sv/buttond/run 0755 0 0

# U-Boot env blobs (tools/mkflash.py env) and updater
dir /etc/uboot 0755 0 0
file /etc/uboot/env-a.bin ${ONU_ROOT}/initramfs/etc/uboot/env-a.bin 0644 0 0
file /etc/uboot/env-b.bin ${ONU_ROOT}/initramfs/etc/uboot/env-b.bin 0644 0 0
file /etc/uboot/env-try-a.bin ${ONU_ROOT}/initramfs/etc/uboot/env-try-a.bin 0644 0 0
file /etc/uboot/env-try-b.bin ${ONU_ROOT}/initramfs/etc/uboot/env-try-b.bin 0644 0 0
file /sbin/sysupgrade ${ONU_ROOT}/initramfs/sysupgrade 0755 0 0
file /sbin/mtdname ${ONU_ROOT}/initramfs/mtdname 0755 0 0
file /sbin/buttond ${ONU_ROOT}/initramfs/buttond 0755 0 0
file /sbin/optics ${ONU_ROOT}/initramfs/optics 0755 0 0

# Users, network config, SSH
dir /root 0700 0 0
file /etc/passwd ${ONU_ROOT}/initramfs/etc/passwd 0644 0 0
file /etc/shadow ${ONU_ROOT}/initramfs/etc/shadow 0600 0 0
file /etc/group ${ONU_ROOT}/initramfs/etc/group 0644 0 0
file /etc/hosts ${ONU_ROOT}/initramfs/etc/hosts 0644 0 0
file /etc/network.conf ${ONU_ROOT}/initramfs/etc/network.conf 0644 0 0
file /etc/udhcpc.script ${ONU_ROOT}/initramfs/etc/udhcpc.script 0755 0 0
dir /etc/ssh 0755 0 0
file /etc/ssh/authorized_keys ${ONU_ROOT}/initramfs/etc/ssh/authorized_keys 0644 0 0
file /bin/dropbearmulti ${ONU_ROOT}/initramfs/dropbearmulti 0755 0 0
slink /bin/dropbear dropbearmulti 0777 0 0
slink /bin/dropbearkey dropbearmulti 0777 0 0
slink /bin/scp dropbearmulti 0777 0 0
